<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zero9.mapper.SysMenuMapper">

    <resultMap id="BaseResultMap" type="com.zero9.domain.SysMenu">
        <id property="id" column="id" />
        <result property="menuName" column="menu_name" />
        <result property="parentId" column="parent_id" />
        <result property="sort" column="sort" />
        <result property="path" column="path" />
        <result property="component" column="component" />
        <result property="query" column="query" />
        <result property="routeName" column="route_name" />
        <result property="menuType" column="menu_type" />
        <result property="status" column="status" />
        <result property="perms" column="perms" />
        <result property="icon" column="icon" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="Base_Column_List">
        id,menu_name,parent_id,sort,path,component,
        query,route_name,menu_type,status,perms,
        icon,create_time,update_time,remark
    </sql>

    <select id="selectPermsByUserId" resultType="String">
        SELECT DISTINCT m.perms
        FROM sys_user_role ur
        JOIN sys_role_menu rm ON ur.role_id = rm.role_id
        JOIN sys_menu m ON rm.menu_id = m.id
        WHERE ur.user_id = #{userId}
            AND m.perms IS NOT NULL
            AND m.perms != ''
            AND m.status = 0;
    </select>

    <!--根据用户id查询菜单-->
    <select id="selectMenuByUserId" resultType="com.zero9.domain.SysMenu">
        SELECT DISTINCT m.*
        FROM sys_menu m
        INNER JOIN sys_role_menu rm ON m.id = rm.menu_id
        INNER JOIN sys_user_role ur ON rm.role_id = ur.role_id
        WHERE ur.user_id = #{userId}
            AND m.status = 0
        ORDER BY m.sort
    </select>

    <select id="selectMenuIdsByRoleId" resultType="Long">
        SELECT DISTINCT m.id
        FROM sys_role_menu ru
                 JOIN sys_menu m ON ru.menu_id = m.id
        WHERE ru.role_id = #{roleId}
          AND m.status = 0
    </select>

    <select id="checkMenuUnique" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM sys_menu
        <trim prefix="WHERE" prefixOverrides="AND |OR ">
            <if test="menuName != null and menuName != ''">
                OR menu_name = #{menuName}
            </if>
            <if test="path != null and path != ''">
                OR path = #{path}
            </if>
            <if test="component != null and component != ''">
                OR component = #{component}
            </if>
            <if test="perms != null and perms != ''">
                OR perms = #{perms}
            </if>
        </trim>
        LIMIT 1
    </select>
</mapper>
